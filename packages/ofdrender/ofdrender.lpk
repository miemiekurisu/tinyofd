<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <Name Value="ofdrender" />
    <Type Value="RunTime" />
    <BuildMethod Value="Both" />
    <Description Value="OFD rendering library" />
    <CompilerOptions>
      <Version Value="11" />
      <SearchPaths>
